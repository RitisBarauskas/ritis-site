# Local development: copy to api/.env (ignored by git).
# These are Flitt's PUBLIC test merchant credentials (https://docs.flitt.com/api/testing/).
# Real merchant credentials never go into a file in this repository: they live in Secret Manager.
RITIS_FLITT_MERCHANT_ID=1549901
RITIS_FLITT_SECRET_KEY=test

# Flitt cannot reach localhost, so notifications do not arrive locally; the booking page's
# poll re-checks the payment instead.
RITIS_API_BASE_URL=http://127.0.0.1:8000
RITIS_SITE_URL=http://127.0.0.1:4321
RITIS_CATALOG_PATH=../shared/catalog.json
