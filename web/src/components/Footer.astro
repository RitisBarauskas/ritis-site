---
import { contentIn } from '../i18n/content';
import { localeOfUrl, localized } from '../i18n/locales';
import { links, merchant } from '../site.config';

const locale = localeOfUrl(Astro.url);
const t = contentIn(locale).footer;
---
<footer>
  <div class="wrap foot">
    <span>© {merchant.nameLatin}</span>
    <nav aria-label={t.label}>
      <a href={localized(locale, '/offer/')}>{t.offer}</a>
      <a href={localized(locale, '/refund/')}>{t.refund}</a>
      <a href={localized(locale, '/privacy/')}>{t.privacy}</a>
      <a href={localized(locale, '/details/')}>{t.details}</a>
      <a href={`mailto:${links.email}`}>{links.email}</a>
      <a href={links.telegram} target="_blank" rel="noopener">Telegram</a>
      <a href={links.youtube} target="_blank" rel="noopener">YouTube</a>
    </nav>
  </div>
</footer>

<style>
footer{border-block-start:1px solid var(--line);padding-block:34px 110px;color:var(--muted);font-size:14.5px}
.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.foot nav{display:flex;gap:20px;flex-wrap:wrap}
.foot a{text-decoration:none}
.foot a:hover{color:var(--ink)}
</style>
