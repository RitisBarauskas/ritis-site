---
import { contentIn } from '../i18n/content';
import { LANGUAGE_CODES, LANGUAGE_NAMES, LOCALES, localeOfUrl, localized, withoutLocale } from '../i18n/locales';

const locale = localeOfUrl(Astro.url);
const t = contentIn(locale).nav;
const home = localized(locale, '/');
const path = withoutLocale(Astro.url.pathname);
---
<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href={`${home}#top`} aria-label="ritis.dev">ritis<span class="dot">.</span><small>do it right</small></a>
    <nav class="nav-links" aria-label={t.label}>
      <a href={`${home}#ask`}>{t.ask}</a>
      <a href={`${home}#models`}>{t.models}</a>
      <a href={`${home}#help`}>{t.help}</a>
      <a href={`${home}#about`}>{t.about}</a>
    </nav>
    <div class="nav-tools">
      <nav class="langs" aria-label={t.languages}>
        {LOCALES.map((l) => (
          <a href={localized(l, path)} hreflang={l} lang={l} title={LANGUAGE_NAMES[l]} aria-label={LANGUAGE_NAMES[l]} aria-current={l === locale ? 'page' : undefined} data-lang-switch>{LANGUAGE_CODES[l]}</a>
        ))}
      </nav>
      {/* Runs as the page is parsed, before the page's scripts load: the same page in another
          language keeps its query and section from the first moment (a booking page, its id). */}
      <script is:inline>
        for (const a of document.querySelectorAll('[data-lang-switch]')) a.href = a.pathname + location.search + location.hash;
      </script>
      <button type="button" class="icon-btn" id="theme" aria-label={t.theme}>◐</button>
      <a href="#book" class="btn btn-primary btn-sm" data-book="start">{t.cta}</a>
    </div>
  </div>
</header>

<script>
  import { all, byId } from '../scripts/dom';

  const root = document.documentElement;
  byId('theme', HTMLButtonElement).addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('ritis-theme', next);
    } catch {
      // Storage can be blocked (private mode): the theme still switches for this visit.
    }
  });

  // A section reached after the page loaded (a link to #help, say) is kept as well.
  for (const link of all<HTMLAnchorElement>('[data-lang-switch]')) {
    link.addEventListener('click', () => {
      link.href = link.pathname + window.location.search + window.location.hash;
    });
  }
</script>

<style>
.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);border-block-end:1px solid var(--line)}
.nav-in{display:flex;align-items:center;gap:20px;height:66px}
.logo{display:flex;align-items:baseline;gap:10px;text-decoration:none;font-weight:800;font-size:23px;letter-spacing:-.03em}
.logo .dot{color:var(--accent)}
.logo small{font-family:var(--mono);font-size:11px;font-weight:500;color:var(--muted);letter-spacing:.1em;text-transform:uppercase}
.nav-links{display:flex;gap:24px;margin-inline-start:auto}
.nav-links a{text-decoration:none;font-size:15px;color:var(--muted);font-weight:600;transition:color .15s}
.nav-links a:hover{color:var(--ink)}
.nav-tools{display:flex;align-items:center;gap:10px}
.langs{display:flex;gap:2px;font:600 12px/1 var(--mono)}
.langs a{padding:7px 6px;border-radius:7px;text-decoration:none;color:var(--muted)}
.langs a:hover{color:var(--ink)}
.langs a[aria-current="page"]{color:var(--ink);background:var(--accent-soft)}

@media (max-width:1000px){
  .nav-links{display:none}
  .nav-tools{margin-inline-start:auto}
}
@media (max-width:640px){
  .nav-tools .btn{display:none}
}
</style>
