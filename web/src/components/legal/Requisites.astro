---
import { links, merchant } from '../../site.config';
---
<dl class="requisites">
  <dt>Исполнитель</dt>
  <dd>{merchant.name} ({merchant.nameLatin})</dd>
  <dt>Регистрационный номер</dt>
  <dd>{merchant.registryId}, {merchant.registry}</dd>
  <dt>Страна регистрации</dt>
  <dd>{merchant.country}</dd>
  <dt>Электронная почта</dt>
  <dd><a href={`mailto:${links.email}`}>{links.email}</a></dd>
</dl>
