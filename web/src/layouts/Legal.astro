---
import { contentIn } from '../i18n/content';
import { localeOfUrl } from '../i18n/locales';
import { legalDate } from '../site.config';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** The date of this revision, YYYY-MM-DD. */
  revised: string;
}

const { title, description, revised } = Astro.props;
const locale = localeOfUrl(Astro.url);
---
<Base title={`${title} — ritis.dev`} description={description}>
  <section class="block">
    <div class="wrap legal">
      <h1>{title}</h1>
      <p class="revised">{contentIn(locale).legal.revised(legalDate(locale, revised))}</p>
      <slot />
    </div>
  </section>
</Base>

<style>
.legal{max-width:780px;padding-block:96px 0}
.legal h1{font-size:clamp(32px,4vw,48px);margin:0 0 10px}
.revised{color:var(--muted);font:500 13px/1.4 var(--mono);margin:0 0 40px}
.legal :global(h2){font-size:22px;line-height:1.3;letter-spacing:-.015em;margin:44px 0 12px}
.legal :global(h3){font-size:18px;margin:28px 0 8px}
.legal :global(p),.legal :global(li),.legal :global(dd){font-size:16px;line-height:1.65}
.legal :global(p){margin:0 0 12px}
.legal :global(ol),.legal :global(ul){padding-inline-start:22px;margin:0 0 12px}
.legal :global(li){margin-bottom:6px}
.legal :global(dl){margin:0}
.legal :global(dt){font-weight:700;margin-top:18px}
.legal :global(dd){margin:4px 0 0}
@media (max-width:640px){
  .legal{padding-block:64px 0}
}
</style>
