---
import { Picture } from 'astro:assets';
import about from '../assets/img/about.jpg';
import { pageContent } from '../i18n/content';
import { links } from '../site.config';

// The landscape photo is cropped into a 4:5 frame by object-fit:cover, so the rendered image
// is ~2.2× wider than the frame. The source is 1216px wide, which caps what we can serve.
const aboutSizes = '(max-width: 640px) calc((100vw - 36px) * 2.2), 930px';
const t = pageContent(Astro.url).about;
---
<section class="block" id="about">
  <div class="wrap about">
    <div class="frame"><Picture src={about} alt={t.photoAlt} formats={['avif', 'webp']} widths={[700, 1216]} sizes={aboutSizes} /></div>
    <div class="about-text">
      <p class="label"><b>07</b>{t.label}</p>
      <h2>{t.title}</h2>
      {t.parasHtml.map((para) => <p set:html={para}></p>)}
      <div class="principles">
        {t.principles.map((principle) => <div class="pr"><h4>{principle.title}</h4><p>{principle.text}</p></div>)}
      </div>
      <blockquote>
        {t.quote}
        <small>{t.quoteNote}</small>
      </blockquote>
      <div class="socials">
        <a class="btn btn-ghost btn-sm" href={links.github} target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn-ghost btn-sm" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost btn-sm" href={links.youtube} target="_blank" rel="noopener">YouTube</a>
        <a class="btn btn-ghost btn-sm" href={links.telegram} target="_blank" rel="noopener">Telegram</a>
      </div>
    </div>
  </div>
</section>

<style>
.about{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;align-items:start}
.about>*{min-width:0}
.about .frame{aspect-ratio:4/5;border-radius:24px;overflow:hidden;background:#d9d4cb;position:sticky;top:96px}
.about .frame :global(img){width:100%;height:100%;object-fit:cover;object-position:50% 22%}
.about-text p:not(.label){font-size:18.5px;margin:0 0 16px}
.principles{display:grid;grid-template-columns:repeat(2,1fr);gap:22px 26px;margin-top:34px}
.pr{border-block-start:2px solid var(--ink);padding-block-start:14px}
.pr h4{margin:0 0 6px;font-size:17px}
.pr p{margin:0;color:var(--muted);font-size:15px;line-height:1.5}
blockquote{margin:36px 0 0;padding:22px 26px;border-inline-start:4px solid var(--accent);background:var(--accent-soft);border-radius:0 14px 14px 0;font-size:19px;font-weight:700;line-height:1.4}
blockquote small{display:block;margin-top:10px;font:500 13px/1.5 var(--mono);color:var(--muted)}
.socials{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}

@media (max-width:1000px){
  .about{grid-template-columns:1fr}
  .about .frame{position:static;max-width:420px}
}
@media (max-width:640px){
  .principles{grid-template-columns:1fr}
}
</style>
