---
import { Picture } from 'astro:assets';
import channel from '../assets/img/channel.jpg';
import { pageContent } from '../i18n/content';
import { links } from '../site.config';

const t = pageContent(Astro.url).channel;
---
<section class="block">
  <div class="wrap">
    <div class="band">
      <div>
        <p class="label"><b>08</b>{t.label}</p>
        <h2>{t.title}</h2>
        <p class="sub">{t.sub}</p>
        <div class="series">
          {t.series.map((name) => <span>{name}</span>)}
        </div>
        <div class="cta-row">
          <a class="btn btn-primary" href={links.youtube} target="_blank" rel="noopener">YouTube</a>
          <a class="btn btn-ghost" href={links.telegram} target="_blank" rel="noopener">Telegram @ritisdoit</a>
          <a class="btn btn-ghost" href="#book" data-book="teardown">{t.teardown}</a>
        </div>
      </div>
      <figure class="polaroid">
        <Picture src={channel} alt="" formats={['avif', 'webp']} widths={[280, 560]} sizes="276px" />
        <figcaption>{t.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
.band{background:var(--ink);color:var(--bg);border-radius:30px;padding:60px;display:grid;grid-template-columns:1.25fr .75fr;gap:48px;align-items:center}
.band>*{min-width:0}
.band .label{color:color-mix(in srgb,var(--bg) 60%,transparent)}
.band .sub{color:color-mix(in srgb,var(--bg) 72%,transparent)}
.band .cta-row .btn-ghost{color:var(--bg);border-color:color-mix(in srgb,var(--bg) 30%,transparent)}
.band .cta-row .btn-ghost:hover{border-color:var(--bg)}
.series{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.series span{font:500 12px/1 var(--mono);border:1px solid color-mix(in srgb,var(--bg) 25%,transparent);border-radius:999px;padding:8px 12px;color:color-mix(in srgb,var(--bg) 80%,transparent)}
.polaroid{background:#FBFAF7;padding:12px 12px 60px;border-radius:6px;transform:rotate(3deg);box-shadow:0 30px 50px -24px rgba(0,0,0,.6);position:relative;color:#151412;width:100%;max-width:300px;justify-self:center;margin:0}
.polaroid :global(img){aspect-ratio:3/4;object-fit:cover;width:100%;height:auto}
.polaroid figcaption{position:absolute;inset-inline:16px;inset-block-end:14px;font:600 14px/1.3 var(--sans)}

@media (max-width:1000px){
  .band{grid-template-columns:1fr;padding:40px}
}
@media (max-width:640px){
  .band{padding:28px;border-radius:22px}
}
</style>
