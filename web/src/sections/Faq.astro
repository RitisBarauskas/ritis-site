---
import { contentIn } from '../i18n/content';
import { localeOfUrl, localized } from '../i18n/locales';
import { pricesIn } from '../site.config';

const locale = localeOfUrl(Astro.url);
const t = contentIn(locale).faq;
const context = { prices: pricesIn(locale), refund: localized(locale, '/refund/') };
---
<section class="block" id="faq">
  <div class="wrap">
    <p class="label"><b>09</b>{t.label}</p>
    <h2>{t.title}</h2>
    <div class="faq">
      {t.items.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p set:html={item.a(context)}></p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
.faq{margin-top:40px;border-block-start:1px solid var(--line);max-width:860px}
details{border-block-end:1px solid var(--line)}
summary{list-style:none;cursor:pointer;padding:24px 0;font-weight:700;font-size:19px;display:flex;justify-content:space-between;align-items:center;gap:20px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";flex:none;font:400 28px/1 var(--mono);color:var(--muted);transition:transform .2s}
details[open] summary::after{transform:rotate(45deg)}
details p{margin:0 0 24px;color:var(--muted);max-width:70ch;font-size:16.5px}
</style>
