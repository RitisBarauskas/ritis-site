---
import { pageContent } from '../i18n/content';

const t = pageContent(Astro.url).final;
---
<section class="final">
  <div class="wrap">
    <h2>{t.title}</h2>
    <div class="cta-row">
      <a href="#book" class="btn btn-primary" data-book="start">{t.cta}</a>
    </div>
  </div>
</section>

<style>
.final{text-align:center;padding-block:120px 110px}
.final h2{margin-inline:auto;max-width:20ch;font-size:clamp(33px,4.6vw,60px)}
.final .cta-row{justify-content:center}
</style>
