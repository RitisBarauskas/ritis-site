---
import { pageContent } from '../i18n/content';

const t = pageContent(Astro.url).models;
---
<section class="block" id="models">
  <div class="wrap">
    <p class="label"><b>03</b>{t.label}</p>
    <h2 set:html={t.titleHtml}></h2>
    {t.subs.map((sub) => <p class="sub">{sub}</p>)}
    <div class="vehicles">
      {t.vehicles.map((vehicle) => (
        <article class="veh">
          <span class="ico" aria-hidden="true">{vehicle.icon}</span>
          <h3>{vehicle.title}</h3>
          <span class="eq">{vehicle.eq}</span>
          <p>{vehicle.text}</p>
          <p class="when">{vehicle.when}</p>
        </article>
      ))}
    </div>
    <div class="price-strip">
      <b set:html={t.stripValueHtml}></b>
      <p set:html={t.stripHtml}></p>
    </div>
  </div>
</section>

<style>
.vehicles{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;margin-top:48px}
.vehicles>*,.price-strip>*{min-width:0}
.veh{grid-column:span 2;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:26px;display:flex;flex-direction:column;gap:10px}
.veh:nth-child(n+4){grid-column:span 3}
.veh .ico{font-size:32px;line-height:1}
.veh h3{margin:6px 0 0;font-size:21px;letter-spacing:-.015em}
.veh .eq{align-self:flex-start;font:500 12.5px/1.45 var(--mono);background:var(--accent-soft);color:var(--ink);padding:5px 9px;border-radius:6px}
.veh p{margin:0;color:var(--muted);font-size:15.5px}
.veh .when{margin-top:auto;padding-top:14px;border-top:1px dashed var(--line);font-size:14.5px;color:var(--ink);font-weight:600}
.price-strip{margin-top:20px;display:grid;grid-template-columns:auto 1fr;gap:26px;align-items:center;background:var(--ink);color:var(--bg);border-radius:20px;padding:26px 30px}
.price-strip b{font-size:clamp(40px,4.4vw,56px);font-weight:800;letter-spacing:-.04em;color:var(--accent);line-height:1}
.price-strip p{margin:0;font-size:16.5px;color:color-mix(in srgb,var(--bg) 82%,transparent)}
.price-strip p strong{color:var(--bg)}

@media (max-width:1000px){
  .vehicles{grid-template-columns:1fr 1fr}
  .veh,.veh:nth-child(n+4){grid-column:auto}
}
@media (max-width:640px){
  .vehicles{grid-template-columns:1fr}
  .price-strip{grid-template-columns:1fr;gap:12px}
}
</style>
