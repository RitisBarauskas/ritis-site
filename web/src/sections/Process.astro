---
import { pageContent } from '../i18n/content';

const t = pageContent(Astro.url).process;
---
<section class="block">
  <div class="wrap">
    <p class="label"><b>06</b>{t.label}</p>
    <h2>{t.title}</h2>
    <div class="steps">
      {t.steps.map((step) => <div class="step"><h3>{step.title}</h3><p>{step.text}</p></div>)}
    </div>
  </div>
</section>

<style>
.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:52px;counter-reset:s;border-block-start:1px solid var(--line)}
.steps>*{min-width:0}
.step{padding:28px 26px 0 0;position:relative}
.step::before{counter-increment:s;content:"0" counter(s);font:600 13px/1 var(--mono);color:var(--accent);display:block;margin-bottom:14px}
.step::after{content:"";position:absolute;inset-block-start:-5px;inset-inline-start:0;width:9px;height:9px;border-radius:50%;background:var(--ink)}
.step h3{font-size:19px;margin:0 0 8px;letter-spacing:-.01em}
.step p{color:var(--muted);font-size:15.5px;margin:0}

@media (max-width:1000px){
  .steps{grid-template-columns:repeat(2,1fr);row-gap:28px}
}
@media (max-width:640px){
  .steps{grid-template-columns:1fr}
}
</style>
