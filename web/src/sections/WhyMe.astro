---
import { pageContent } from '../i18n/content';

const t = pageContent(Astro.url).why;
---
<section class="block">
  <div class="wrap">
    <p class="label"><b>01</b>{t.label}</p>
    <h2 set:html={t.titleHtml}></h2>
    <p class="sub">{t.sub}</p>
    <div class="cards3">
      {t.cards.map((card) => (
        <article class="card">
          <span class="k">{card.k}</span>
          <h3>{card.title}</h3>
          <p set:html={card.textHtml}></p>
        </article>
      ))}
    </div>
  </div>
</section>
